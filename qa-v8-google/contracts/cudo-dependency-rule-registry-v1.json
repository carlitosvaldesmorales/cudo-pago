          },
          "expected": 37200
        }
      ]
    },
    {
      "rule_id": "RULE_SALES_REVENUE_V1",
      "version": 1,
      "status": "ACTIVE",
      "inputs": [
        {
          "name": "sold_qty",
          "selector": {
            "scope": "SOURCE_OBJECT",
            "object_type": "RESOURCE_FACILITY",
            "field": "sold_qty"
          }
        },
        {
          "name": "sell_price",
          "selector": {
            "scope": "SOURCE_OBJECT",
            "object_type": "RESOURCE_FACILITY",
            "field": "sell_price"
          }
        }
      ],
      "outputs": [
        {
          "name": "sales_revenue",
          "selector": {
            "scope": "RELATED_OBJECT",
            "object_type": "ACTIVITY_EVENT",
            "field": "sales_revenue",
            "relationship_type": "USED_BY_EVENT"
          }
        }
      ],
      "expression": {
        "operator": "MULTIPLY",
        "args": [
          "sold_qty",
          "sell_price"
        ]
      },
      "applicability": {
        "mode": "CONDITIONAL",
        "condition_id": "SINGLE_RESOURCE_DIRECT_SALES_MODEL",
        "description": "Legacy bounded single-resource event flow: one resource writes the event sales revenue directly."
      },
      "evidence": {
        "evidence_level": "DIRECT",
        "source_refs": [
          "arke-root:05_CASOS/CASO_CUDO_001/CUDO_REAL_EVENT_SEMANTIC_MAP_v1.yaml#EQ_SALES_REVENUE",
          "artifact:PEDIDO CUDO.xlsx"
        ]
      },
      "test_cases": [
        {
          "inputs": {
            "sold_qty": 70,
            "sell_price": 1500
          },
          "expected": 105000
        }
      ]
    },
    {
      "rule_id": "RULE_STOCK_AFTER_SALES_V1",
      "version": 1,
      "status": "ACTIVE",
      "inputs": [
        {
          "name": "stock_available_before_sales",
          "selector": {
            "scope": "SOURCE_OBJECT",
            "object_type": "RESOURCE_FACILITY",
            "field": "stock_available_before_sales"
          }
        },
        {
          "name": "sold_qty",
          "selector": {
            "scope": "SOURCE_OBJECT",
            "object_type": "RESOURCE_FACILITY",
            "field": "sold_qty"
          }
        }
      ],
      "outputs": [
        {
          "name": "stock_after_sales",
          "selector": {
            "scope": "SOURCE_OBJECT",
            "object_type": "RESOURCE_FACILITY",
            "field": "stock_after_sales"
          }
        }
      ],
      "expression": {
        "operator": "SUBTRACT",
        "args": [
          "stock_available_before_sales",
          "sold_qty"
        ]
      },
      "applicability": {
        "mode": "ALWAYS"
      },
      "evidence": {
        "evidence_level": "DIRECT",
        "source_refs": [
          "arke-root:05_CASOS/CASO_CUDO_001/CUDO_REAL_EVENT_SEMANTIC_MAP_v1.yaml#EQ_STOCK_AFTER_SALES",
          "artifact:PEDIDO CUDO.xlsx"
        ]
      },
      "test_cases": [
        {
          "inputs": {
            "stock_available_before_sales": 100,
            "sold_qty": 70
          },
          "expected": 30
        }
      ]
    },
    {
      "rule_id": "RULE_PAYABLE_QTY_AFTER_RETURN_V1",
      "version": 1,
      "status": "ACTIVE",
      "inputs": [
        {
          "name": "received_qty",
          "selector": {
            "scope": "SOURCE_OBJECT",
            "object_type": "RESOURCE_FACILITY",
            "field": "received_qty"
          }
        },
        {
          "name": "returned_qty",
          "selector": {
            "scope": "SOURCE_OBJECT",
            "object_type": "RESOURCE_FACILITY",
            "field": "returned_qty"
          }
        }
      ],
      "outputs": [
        {
          "name": "payable_qty",
          "selector": {
            "scope": "RELATED_OBJECT",
            "object_type": "FINANCIAL_OBLIGATION",
            "field": "payable_qty",
            "relationship_type": "CREATES_OBLIGATION"
          }
        }
      ],
      "expression": {
        "operator": "SUBTRACT",
        "args": [
          "received_qty",
          "returned_qty"
        ]
      },
      "applicability": {
        "mode": "CONDITIONAL",
        "condition_id": "SUPPLIER_RETURN_MODEL_APPLIES",
        "description": "Only where the supplier arrangement permits unsold stock to be returned before settlement."
      },
      "evidence": {
        "evidence_level": "DIRECT_PATTERN",
        "source_refs": [
          "arke-root:05_CASOS/CASO_CUDO_001/CUDO_REAL_EVENT_SEMANTIC_MAP_v1.yaml#EQ_PAYABLE_QTY_AFTER_RETURN",
          "artifact:Check-List tareas estadio y partidos.xlsx",
          "artifact:PEDIDO CUDO.xlsx"
        ]
      },
      "test_cases": [
        {
          "inputs": {
            "received_qty": 100,
            "returned_qty": 20
          },
          "expected": 80
        }
      ]
    },
    {
      "rule_id": "RULE_SUPPLIER_PAYABLE_V1",
      "version": 1,
      "status": "ACTIVE",
      "inputs": [
        {
          "name": "payable_qty",
          "selector": {
            "scope": "SOURCE_OBJECT",
            "object_type": "FINANCIAL_OBLIGATION",
            "field": "payable_qty"
          }
        },
        {
          "name": "unit_cost",
          "selector": {
            "scope": "RELATED_OBJECT",
            "object_type": "RESOURCE_FACILITY",
            "field": "unit_cost",
            "relationship_type": "CAUSED_BY_RESOURCE"
          }
        }
      ],
      "outputs": [
        {
          "name": "supplier_payable",
          "selector": {
            "scope": "SOURCE_OBJECT",
            "object_type": "FINANCIAL_OBLIGATION",
            "field": "supplier_payable"
          }
        }
      ],
      "expression": {
        "operator": "MULTIPLY",
        "args": [
          "payable_qty",
          "unit_cost"
        ]
      },
      "applicability": {
        "mode": "CONDITIONAL",
        "condition_id": "UNIT_COST_MODEL_APPLIES",
        "description": "Only where the payable is valued by payable quantity multiplied by unit cost."
      },
      "evidence": {
        "evidence_level": "DIRECT",
        "source_refs": [
          "arke-root:05_CASOS/CASO_CUDO_001/CUDO_REAL_EVENT_SEMANTIC_MAP_v1.yaml#EQ_SUPPLIER_PAYABLE",
          "artifact:PEDIDO CUDO.xlsx"
        ]
      },
      "test_cases": [
        {
          "inputs": {
            "payable_qty": 80,
            "unit_cost": 500
          },
          "expected": 40000
        }
      ]
    },
    {
      "rule_id": "RULE_EVENT_OPERATING_RESULT_V1",
      "version": 1,
      "status": "ACTIVE",
      "inputs": [
        {
          "name": "actual_revenue_streams",
          "selector": {
            "scope": "SOURCE_OBJECT",
            "object_type": "ACTIVITY_EVENT",
            "field": "actual_revenue_streams"
          }
        },
        {
          "name": "actual_expense_streams",
          "selector": {
            "scope": "SOURCE_OBJECT",
            "object_type": "ACTIVITY_EVENT",
            "field": "actual_expense_streams"
          }
        }
      ],
      "outputs": [
        {
          "name": "event_operating_result",
          "selector": {
            "scope": "SOURCE_OBJECT",
            "object_type": "ACTIVITY_EVENT",
            "field": "event_operating_result"
          }
        }
      ],
      "expression": {
        "operator": "SUM_DIFFERENCE",
        "args": [
          "actual_revenue_streams",
          "actual_expense_streams"
        ]
      },
      "applicability": {
        "mode": "ALWAYS"
      },
      "evidence": {
        "evidence_level": "DIRECT_PATTERN",
        "source_refs": [
          "arke-root:05_CASOS/CASO_CUDO_001/CUDO_REAL_EVENT_SEMANTIC_MAP_v1.yaml#EQ_EVENT_OPERATING_RESULT",
          "artifact:PEDIDO CUDO.xlsx"
        ],
        "note": "Operational event result pattern only; not asserted as a statutory accounting definition."
      },
      "test_cases": [
        {
          "inputs": {
            "actual_revenue_streams": [
              105000,
              200000
            ],
            "actual_expense_streams": [
              40000,
              25000,
              120000
            ]
          },
          "expected": 120000
        }
      ]
    },
    {
      "rule_id": "RULE_OBLIGATION_AMOUNT_FROM_SUPPLIER_PAYABLE_V1",
      "version": 1,
      "status": "ACTIVE",
      "inputs": [
        {
          "name": "supplier_payable",
          "selector": {
            "scope": "SOURCE_OBJECT",
            "object_type": "FINANCIAL_OBLIGATION",
            "field": "supplier_payable"
          }
        }
      ],
      "outputs": [
        {
          "name": "amount",
          "selector": {
            "scope": "SOURCE_OBJECT",
            "object_type": "FINANCIAL_OBLIGATION",
            "field": "amount"
          }
        }
      ],
      "expression": {
        "operator": "IDENTITY",
        "args": [
          "supplier_payable"
        ]
      },
      "applicability": {
        "mode": "CONDITIONAL",
        "condition_id": "CANONICAL_FINANCIAL_AMOUNT_BINDING_APPLIES",
        "description": "Apply only to obligations that already implement the canonical financial amount field."
      },
      "evidence": {
        "evidence_level": "DIRECT_PATTERN",
        "source_refs": [
          "artifact:PEDIDO CUDO.xlsx#'Pedido vs San Ramon 04-05-2025'!K3",
          "arke-root:05_CASOS/CASO_CUDO_001/CUDO_CANONICAL_FINANCIAL_CORE_CHECKPOINT_v1.yaml"
        ],
        "note": "For a supplier settlement obligation, the canonical obligation amount is the calculated supplier payable for the same causal resource."
      },
      "test_cases": [
        {
          "inputs": {
            "supplier_payable": 43680
          },
          "expected": 43680
        }
      ]
    },
    {
      "rule_id": "RULE_RESOURCE_SALES_REVENUE_V1",
      "version": 1,
      "status": "ACTIVE",
      "inputs": [
        {
          "name": "sold_qty",
          "selector": {
            "scope": "SOURCE_OBJECT",
            "object_type": "RESOURCE_FACILITY",
            "field": "sold_qty"
          }
        },
        {
          "name": "sell_price",
          "selector": {
            "scope": "SOURCE_OBJECT",
            "object_type": "RESOURCE_FACILITY",
            "field": "sell_price"
          }
        }
      ],
      "outputs": [
        {
          "name": "sales_revenue",
          "selector": {
            "scope": "SOURCE_OBJECT",
            "object_type": "RESOURCE_FACILITY",
            "field": "sales_revenue"
          }
        }
      ],
      "expression": {
        "operator": "MULTIPLY",
        "args": [
          "sold_qty",
          "sell_price"
        ]
      },
      "applicability": {
        "mode": "CONDITIONAL",
        "condition_id": "MULTI_RESOURCE_AGGREGATED_SALES_MODEL",
        "description": "Multi-resource event model: calculate each resource sales stream before event aggregation."
      },
      "evidence": {
        "evidence_level": "DIRECT",
        "source_refs": [
          "artifact:PEDIDO CUDO.xlsx#'Pedido vs San Ramon 04-05-2025'!G3:J7"
        ],
        "note": "Each product sales stream is quantity sold multiplied by its sale price."
      },
      "test_cases": [
        {
          "inputs": {
            "sold_qty": 52,
            "sell_price": 2000
          },
          "expected": 104000
        }
      ]
    },
    {
      "rule_id": "RULE_EVENT_SALES_REVENUE_SUM_V1",
      "version": 1,
      "status": "ACTIVE",
      "inputs": [
        {
          "name": "resource_sales_revenues",
          "selector": {
            "scope": "REVERSE_RELATED_OBJECTS",
            "object_type": "RESOURCE_FACILITY",
            "field": "sales_revenue",
            "relationship_type": "USED_BY_EVENT"
          }
        }
      ],
      "outputs": [
        {
          "name": "sales_revenue",
          "selector": {
            "scope": "SOURCE_OBJECT",
            "object_type": "ACTIVITY_EVENT",
            "field": "sales_revenue"
          }
        }
      ],
      "expression": {
        "operator": "SUM",
        "args": [
          "resource_sales_revenues"
        ]
      },
      "applicability": {
        "mode": "CONDITIONAL",
        "condition_id": "MULTI_RESOURCE_AGGREGATED_SALES_MODEL",
        "description": "Aggregate all resource sales streams related to the event."
      },
      "evidence": {
        "evidence_level": "DIRECT",
        "source_refs": [
          "artifact:PEDIDO CUDO.xlsx#'Pedido vs San Ramon 04-05-2025'!J3:J8"
        ],
        "note": "J8 is SUM(J3:J7) in the real San Ramon workbook."
      },
      "test_cases": [
        {
          "inputs": {
            "resource_sales_revenues": [
              104000,
              166500,
              36000,
              13500,
              33000
            ]
          },
          "expected": 353000
        }
      ]
    },
    {
      "rule_id": "RULE_RESOURCE_REMAINING_STOCK_VALUE_V1",
      "version": 1,
      "status": "ACTIVE",
      "inputs": [
        {
          "name": "stock_after_sales",
          "selector": {
            "scope": "SOURCE_OBJECT",
            "object_type": "RESOURCE_FACILITY",
            "field": "stock_after_sales"
          }
        },
        {
          "name": "unit_cost",
          "selector": {
            "scope": "SOURCE_OBJECT",
            "object_type": "RESOURCE_FACILITY",
            "field": "unit_cost"
          }
        }
      ],
      "outputs": [
        {
          "name": "remaining_stock_value",
          "selector": {
            "scope": "SOURCE_OBJECT",
            "object_type": "RESOURCE_FACILITY",
            "field": "remaining_stock_value"
          }
        }
      ],
      "expression": {
        "operator": "MULTIPLY",
        "args": [
          "stock_after_sales",
          "unit_cost"
        ]
      },
      "applicability": {
        "mode": "CONDITIONAL",
        "condition_id": "RESOURCE_STOCK_VALUE_MODEL_APPLIES",
        "description": "Value remaining event stock at the same unit cost evidenced by the order sheet."
      },
      "evidence": {
        "evidence_level": "DIRECT",
        "source_refs": [
          "artifact:PEDIDO CUDO.xlsx#'Pedido vs San Ramon 04-05-2025'!I3:L8"
        ],
        "note": "L3/L4 are I*E and L8 sums the per-product remaining-stock values."
      },
      "test_cases": [
        {
          "inputs": {
            "stock_after_sales": 68,
            "unit_cost": 840
          },
          "expected": 57120
        }
      ]
    }
  ],
  "exclusive_condition_groups": [
    {
      "group_id": "EVENT_SALES_MODEL",
      "condition_ids": [
        "SINGLE_RESOURCE_DIRECT_SALES_MODEL",
        "MULTI_RESOURCE_AGGREGATED_SALES_MODEL"
      ]
    }
  ]
}
