{
  "schema_version": "CUDO_DEPENDENCY_RULE_REGISTRY_V1",
  "registry_version": 3,
  "rules": [
    {
      "rule_id": "RULE_ENTRY_REVENUE_V1",
      "version": 1,
      "status": "EXPERIMENTAL",
      "inputs": [
        {
          "name": "paid_entries",
          "selector": {
            "scope": "SOURCE_OBJECT",
            "object_type": "ACTIVITY_EVENT",
            "field": "paid_entries"
          }
        },
        {
          "name": "entry_price",
          "selector": {
            "scope": "SOURCE_OBJECT",
            "object_type": "ACTIVITY_EVENT",
            "field": "entry_price"
          }
        }
      ],
      "outputs": [
        {
          "name": "entry_revenue",
          "selector": {
            "scope": "SOURCE_OBJECT",
            "object_type": "ACTIVITY_EVENT",
            "field": "entry_revenue"
          }
        }
      ],
      "expression": {
        "operator": "MULTIPLY",
        "args": [
          "paid_entries",
          "entry_price"
        ]
      },
      "applicability": {
        "mode": "ALWAYS"
      },
      "evidence": {
        "evidence_level": "SYNTHETIC_CONTRACT_EXAMPLE",
        "source_refs": [
          "qa-v8-google/contracts/cudo-shared-object-fixture-v1.json"
        ],
        "note": "Used only to close the semantic contract introduced by piece 1; not asserted as an operational CUDO accounting rule."
      },
      "test_cases": [
        {
          "inputs": {
            "paid_entries": 70,
            "entry_price": 1500
          },
          "expected": 105000
        }
      ]
    },
    {
      "rule_id": "RULE_PURCHASE_TOTAL_V1",
      "version": 1,
      "status": "ACTIVE",
      "inputs": [
        {
          "name": "purchased_qty",
          "selector": {
            "scope": "SOURCE_OBJECT",
            "object_type": "RESOURCE_FACILITY",
            "field": "purchased_qty"
          }
        },
        {
          "name": "unit_cost",
          "selector": {
            "scope": "SOURCE_OBJECT",
            "object_type": "RESOURCE_FACILITY",
            "field": "unit_cost"
          }
        }
      ],
      "outputs": [
        {
          "name": "purchase_total",
          "selector": {
            "scope": "SOURCE_OBJECT",
            "object_type": "RESOURCE_FACILITY",
            "field": "purchase_total"
          }
        }
      ],
      "expression": {
        "operator": "MULTIPLY",
        "args": [
          "purchased_qty",
          "unit_cost"
        ]
      },
      "applicability": {
        "mode": "ALWAYS"
      },
      "evidence": {
        "evidence_level": "DIRECT",
        "source_refs": [
          "arke-root:05_CASOS/CASO_CUDO_001/CUDO_REAL_EVENT_SEMANTIC_MAP_v1.yaml#EQ_PURCHASE_TOTAL",
          "artifact:PEDIDO CUDO.xlsx"
        ]
      },
      "test_cases": [
        {
          "inputs": {
            "purchased_qty": 24,
