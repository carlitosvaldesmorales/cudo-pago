{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cudo.cl/schemas/dependency-rule-registry-v1.json",
  "title": "CUDO Dependency Rule Registry V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_version",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": "CUDO_DEPENDENCY_RULE_REGISTRY_V1"
    },
    "registry_version": {
      "type": "integer",
      "minimum": 1
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "fieldSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "object_type",
        "field"
      ],
      "properties": {
        "scope": {
          "enum": [
            "SOURCE_OBJECT",
            "RELATED_OBJECT"
          ]
        },
        "object_type": {
          "enum": [
            "ACTOR",
            "ACTIVITY_EVENT",
            "RESOURCE_FACILITY",
            "RULE_DECISION",
            "FINANCIAL_OBLIGATION",
            "FINANCIAL_MOVEMENT",
            "DOCUMENT_EVIDENCE"
          ]
        },
        "field": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,79}$"
        },
        "relationship_type": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,79}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "RELATED_OBJECT"
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "required": [
              "relationship_type"
            ]
          }
        }
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "selector"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,79}$"
        },
        "selector": {
          "$ref": "#/$defs/fieldSelector"
        }
      }
    },
    "expression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "args"
      ],
      "properties": {
        "operator": {
          "enum": [
            "MULTIPLY",
            "SUBTRACT",
            "SUM_DIFFERENCE",
            "IDENTITY"
          ]
        },
        "args": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,79}$"
          }
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "ALWAYS",
            "CONDITIONAL"
          ]
        },
        "condition_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "CONDITIONAL"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "condition_id",
              "description"
            ]
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_level",
        "source_refs"
      ],
      "properties": {
        "evidence_level": {
          "enum": [
            "DIRECT",
            "DIRECT_PATTERN",
            "SYNTHETIC_CONTRACT_EXAMPLE",
            "INFERENCE"
          ]
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "testCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs",
        "expected"
      ],
      "properties": {
        "inputs": {
          "type": "object"
        },
        "expected": {}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "version",
        "status",
        "inputs",
        "outputs",
        "expression",
        "applicability",
        "evidence",
        "test_cases"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^RULE_[A-Z0-9_]+_V[0-9]+$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "ACTIVE",
            "EXPERIMENTAL"
          ]
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "expression": {
          "$ref": "#/$defs/expression"
        },
        "applicability": {
          "$ref": "#/$defs/applicability"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "test_cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/testCase"
          }
        }
      }
    }
  }
}
