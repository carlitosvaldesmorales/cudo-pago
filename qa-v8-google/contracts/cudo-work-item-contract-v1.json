{
  "schema_version": "CUDO_WORK_ITEM_CONTRACT_V1",
  "object_type": "WORK_ITEM",
  "purpose": "Represent canonical human work generated by CLUB state with responsibility, lifecycle, dependencies, evidence and optional financial context.",
  "required_data_fields": [
    "work_kind",
    "title",
    "responsible_actor_id",
    "resource_id",
    "source_object_id",
    "due_date",
    "priority",
    "trigger_reason"
  ],
  "lifecycle_states": [
    "OPEN",
    "IN_PROGRESS",
    "BLOCKED",
    "WAITING_EXTERNAL",
    "DONE",
    "CANCELLED"
  ],
  "relationship_types": [
    "ASSIGNED_TO",
    "APPLIES_TO_RESOURCE",
    "CAUSED_BY_EVENT",
    "DERIVED_FROM_RULE"
  ],
  "governance": {
    "stable_identity_required": true,
    "expected_state_precondition_required_for_transition": true,
    "transition_audit_required": true,
    "evidence_required_for_DONE": true,
    "production_write": false
  },
  "optional_schedule_fields": [
    "schedule_start_date",
    "schedule_expected_end_date",
    "schedule_conditional_extension_date",
    "schedule_condition"
  ],
  "due_date_semantics": "May be a concrete due date when the source supports one. Scheduled work can also expose an explicit operational window and conditional extension without inventing a deadline."
}
